{
  "name": "pi-llama-reasoning",
  "version": "0.2.3",
  "description": "Use native llama.cpp reasoning efforts in Pi’s thinking selector, with matching token budgets and no extra configuration.",
  "type": "module",
  "keywords": [
    "llama.cpp",
    "slots",
    "slot-pinning",
    "reasoning-effort",
    "thinking-budget",
    "reasoning",
    "thinking",
    "openai-api",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/Ryu-CZ/pi-llama-reasoning#readme",
  "bugs": {
    "url": "https://github.com/Ryu-CZ/pi-llama-reasoning/issues"
  },
  "license": "MIT",
  "author": "Ryu-CZ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryu-CZ/pi-llama-reasoning.git"
  },
  "files": ["CHANGELOG.md", "extensions/", "LICENSE", "README.md"],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='extensions/*.ts' --test-coverage-include='extensions/**/*.ts' tests/discovery.test.mjs tests/lifecycle.test.mjs tests/reasoning.test.mjs tests/slot-leases.test.mjs tests/slots.test.mjs",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.2 <1.6.1",
    "@earendil-works/pi-coding-agent": ">=1.5.2 <1.6.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/Ryu-CZ/pi-llama-reasoning/main/media/pi-preview.gif",
    "video": "https://raw.githubusercontent.com/Ryu-CZ/pi-llama-reasoning/main/media/preview-animation.mp4",
    "extensions": ["./extensions/index.ts"]
  }
}
